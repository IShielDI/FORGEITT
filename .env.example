# Copy to .env and fill in. Never commit .env.
# Keys live only in the backend environment on the host; sandboxes never receive them.
# Relative paths resolve from the repo root.

DATABASE_URL=sqlite:///./data/forgeit.db
SECRET_KEY=change-me
GIT_STORAGE_PATH=./data/git
ARTIFACT_PATH=./data/artifacts

# Providers (Claude first): claude | openai_compatible | ollama | mock
# Use mock for development without keys.
LLM_PROVIDER=mock
LLM_MODEL=
ANTHROPIC_API_KEY=
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Referee
TINYFISH_API_KEY=
PUBLIC_TUNNEL_URL=

# Invites and mail (Gmail SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_APP_PASSWORD=
INVITE_TTL_DAYS=7

# Credits
HOUSE_KEY_ENABLED=false
HOUSE_CAP_WORKSPACE_USD=
HOUSE_CAP_PERSON_USD=

# fast | standard | strict
VERIFICATION_PROFILE=fast
