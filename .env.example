# Copy to .env and fill in. Never commit .env.

# Database (docker compose `db` service; local dev credentials only)
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=collab
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/collab

# LLM provider: gemini | groq | openrouter | ollama | mock
LLM_PROVIDER=mock
LLM_MODEL=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# App
SECRET_KEY=change-me
GIT_STORAGE_PATH=./data/git
ARTIFACT_PATH=./data/artifacts
SANDBOX_IMAGE=collab-agent:latest
VERIFICATION_PROFILE=light
