# Copy to .env and fill in. Never commit .env.
# Keys live only in the backend environment on the host; sandboxes never receive them.
# Relative paths resolve from the repo root.

# Platform state (database, encryption key) must be a SIBLING of GIT_STORAGE_PATH,
# never inside or above the agents' workspaces. DATABASE_URL defaults to PLATFORM_STATE/forgeit.db.
PLATFORM_STATE=./data/state
DATABASE_URL=sqlite:///./data/state/forgeit.db
GIT_STORAGE_PATH=./data/git
ARTIFACT_PATH=./data/artifacts
SECRET_KEY=change-me
# Fernet key for stored member keys; if unset, one is generated in PLATFORM_STATE/secret.key
PLATFORM_SECRET=

# Providers (Claude first): claude | openai_compatible | ollama | mock
# Use mock for development without keys.
# mock = offline stand-in for tests. auto = the first model someone can use (a free key, else Claude).
LLM_PROVIDER=mock
LLM_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
# Free-tier providers (Models tab). Optional shared demo keys: anyone in any workspace can run on
# them, so use free-tier keys only. Members can also paste their own key in the Models tab.
# LLM_PROVIDER above may also be one of these, with LLM_MODEL set to one of its models.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
CEREBRAS_API_KEY=
MISTRAL_API_KEY=
GITHUB_MODELS_TOKEN=

# Agents and sandbox: auto (Docker if the image exists) | docker | subprocess
AGENT_SANDBOX=auto
AGENT_IMAGE=forgeit-agent:latest
AGENT_STEP_LIMIT=40
AGENT_TIME_LIMIT_S=1800
# Where candidate code is checked: auto (Docker if the image exists) | docker | host
MIRROR_SANDBOX=auto
MIRROR_IMAGE=forgeit-mirror:latest
# Plain subprocess is NOT a security boundary. Only on a throwaway machine with no secrets.
ALLOW_UNSAFE_SANDBOX=false

# Referee
TINYFISH_API_KEY=
PUBLIC_TUNNEL_URL=
REFEREE_STEP_LIMIT=20
REFEREE_RUNS_PER_HOUR=10
# Offline stand-in for rehearsals only; its results are never a TinyFish verdict.
REFEREE_STANDIN=false

# Access: logins are required. Turn off only for local rehearsal.
REQUIRE_AUTH=true
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Where people open the web app (invite links point here)
PUBLIC_WEB_URL=http://localhost:3000

# Invites and mail (Gmail SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_APP_PASSWORD=
INVITE_TTL_DAYS=7

# Credits
# The house key (ANTHROPIC_API_KEY) pays only when a member's own portion and loans run out,
# and only when BOTH caps are set.
HOUSE_KEY_ENABLED=false
HOUSE_CAP_WORKSPACE_USD=
HOUSE_CAP_PERSON_USD=

# fast | standard | strict
VERIFICATION_PROFILE=fast

# Permanent deployment (docker-compose.yml, scripts/deploy/setup-server.sh fills these in)
# FORGEIT_DOMAIN=forgeit.example.com   # or <server-ip>.sslip.io
# DOCKER_GID=999                       # the server's docker group id
